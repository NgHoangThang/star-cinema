@model CinemaApp.Models.MoviesViewModel
@{
    ViewData["Title"] = "Danh sách phim";
    ViewData["Dark"] = true;
    string heading = Model.Status == "NowShowing" ? "Phim đang chiếu"
                   : Model.Status == "ComingSoon" ? "Phim sắp chiếu" : "Tất cả phim";
}

<style>
    .a-pghead{padding:44px 48px 26px;background:radial-gradient(ellipse at 20% 0%,#2b2013 0%,#0e0c0a 70%);border-bottom:1px solid var(--a-line)}
    .a-pghead .eb{color:var(--a-gold);font-size:12px;letter-spacing:3px}
    .a-pghead h1{font-size:clamp(26px,4vw,40px);font-weight:800;margin:6px 0 6px;color:var(--a-text)}
    .a-pghead p{color:var(--a-mute);margin:0;font-size:14px}
    .a-filter{display:flex;gap:10px;flex-wrap:wrap;padding:20px 48px 0}
    .a-filter .s{flex:1 1 240px;display:flex;align-items:center;gap:8px;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:4px;padding:0 12px;color:var(--a-mute)}
    .a-filter input,.a-filter select{background:transparent;border:0;outline:0;color:var(--a-text);font-size:14px;padding:11px 0;width:100%}
    .a-filter select{background:var(--a-bg2);border:1px solid var(--a-line);border-radius:4px;padding:11px 12px;width:auto;min-width:160px}
    .a-filter select option{background:var(--a-bg2)}
    .a-filter .s:focus-within,.a-filter select:focus{border-color:var(--a-gold)}
    .a-count{padding:16px 48px 0;color:var(--a-mute);font-size:13px;margin:0}
    .a-count b{color:var(--a-gold)}
    .a-empty{margin:24px 48px;padding:30px;border:1px dashed #6b5a3a;border-radius:6px;color:var(--a-mute);text-align:center}
    .a-pager{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;padding:30px 0 0}
    .a-pager a{min-width:38px;height:38px;display:flex;align-items:center;justify-content:center;border:1px solid var(--a-line);border-radius:4px;color:var(--a-mute)!important;text-decoration:none;background:var(--a-bg2)}
    .a-pager a:hover{border-color:var(--a-gold);color:var(--a-gold)!important}
    .a-pager a.active{background:var(--a-gold);border-color:var(--a-gold);color:#1a1208!important;font-weight:700}
    .a-card .poster img{width:100%;height:100%;object-fit:cover;display:block}
    .a-card .play{position:absolute;right:8px;bottom:8px;width:40px;height:40px;border-radius:50%;border:1px solid var(--a-gold);background:rgba(14,12,10,.75);color:var(--a-gold);display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;transition:opacity .2s}
    .a-card:hover .play{opacity:1}
    .a-card .t a{color:var(--a-text)!important;text-decoration:none}
    @@media(max-width:900px){.a-pghead,.a-filter,.a-count{padding-left:16px;padding-right:16px}.a-empty{margin:24px 16px}}
</style>

<div class="a-pghead">
    <div class="eb">STAR CINEMA</div>
    <h1>@heading</h1>
    <p>Tìm phim theo tên, trạng thái hoặc thể loại.</p>
</div>

<form method="get" action="/Movies" class="a-filter">
    <label class="s">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        <input type="search" name="q" value="@Model.Q" placeholder="Tìm theo tên phim" />
    </label>
    <select name="status">
        <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả trạng thái</option>
        <option value="NowShowing" selected="@(Model.Status == "NowShowing")">Đang chiếu</option>
        <option value="ComingSoon" selected="@(Model.Status == "ComingSoon")">Sắp chiếu</option>
    </select>
    <select name="genre">
        <option value="" selected="@(!Model.GenreId.HasValue)">Tất cả thể loại</option>
        @foreach (var g in Model.Genres)
        {
            <option value="@g.Id" selected="@(Model.GenreId == g.Id)">@g.Name</option>
        }
    </select>
    <button type="submit" class="a-btn">Lọc</button>
    <a href="/Movies" class="a-btn ghost">Xóa lọc</a>
</form>

<p class="a-count">Tìm thấy <b>@Model.Total</b> phim</p>

<section class="a-sec" style="padding-top:8px">
    @if (Model.Movies.Count == 0)
    {
        <div class="a-empty" style="margin:16px 0">Không có phim nào khớp bộ lọc. Hãy thử bỏ bớt điều kiện.</div>
    }
    else
    {
        <div class="a-grid">
            @foreach (var m in Model.Movies)
            {
                @await Html.PartialAsync("_MovieCardA", m)
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="a-pager">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-q="@Model.Q" asp-route-status="@Model.Status"
                   asp-route-genre="@Model.GenreId" asp-route-page="@(Model.Page - 1)">‹</a>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a class="@(i == Model.Page ? "active" : "")" asp-action="Index" asp-route-q="@Model.Q"
                   asp-route-status="@Model.Status" asp-route-genre="@Model.GenreId" asp-route-page="@i">@i</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-q="@Model.Q" asp-route-status="@Model.Status"
                   asp-route-genre="@Model.GenreId" asp-route-page="@(Model.Page + 1)">›</a>
            }
        </nav>
    }
</section>

<div class="modal fade" id="trailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content lh-modal">
            <button type="button" class="btn-close btn-close-white lh-modal-x" data-bs-dismiss="modal" aria-label="Đóng"></button>
            <div class="lh-video">
                <iframe id="trailerFrame" src="" title="Trailer" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('load', function () {
            var modal = document.getElementById('trailerModal');
            var frame = document.getElementById('trailerFrame');
            modal.addEventListener('show.bs.modal', function (e) {
                var u = e.relatedTarget && e.relatedTarget.getAttribute('data-trailer');
                if (!u) return;
                frame.src = u + (u.indexOf('?') > -1 ? '&' : '?') + 'autoplay=1';
            });
            modal.addEventListener('hidden.bs.modal', function () { frame.src = ''; });
        });
    </script>
}