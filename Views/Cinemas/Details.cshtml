@model CinemaApp.Models.CinemaDetailsViewModel
@{
    ViewData["Title"] = Model.Cinema.Name;
    ViewData["Dark"] = true;
    var dow = new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
}

<style>
    .a-chero{padding:44px 48px 26px;background:radial-gradient(ellipse at 20% 0%,#2b2013 0%,#0e0c0a 70%);border-bottom:1px solid var(--a-line)}
    .a-chero h1{font-size:clamp(26px,4vw,38px);font-weight:800;margin:0 0 6px;color:var(--a-text)}
    .a-chero p{color:var(--a-mute);margin:0 0 4px;font-size:14px}
    .a-chipseat{display:inline-block;border:1px solid var(--a-gold);color:var(--a-gold);border-radius:4px;padding:2px 9px;font-size:12px;margin:8px 6px 0 0}
    .a-csec{padding:34px 48px 0;max-width:1280px;margin:0 auto}
    .a-days{display:flex;gap:8px;overflow-x:auto;margin-top:18px;padding-bottom:6px}
    .a-day{flex:0 0 auto;min-width:68px;text-align:center;padding:10px 8px;border:1px solid var(--a-line);border-radius:6px;background:var(--a-bg2);text-decoration:none;color:var(--a-mute)!important;transition:border-color .2s,transform .2s}
    .a-day small{display:block;font-size:11px}
    .a-day b{display:block;font-size:20px;color:var(--a-text)}
    .a-day:hover{border-color:var(--a-gold);transform:translateY(-2px)}
    .a-day.active{background:var(--a-gold);border-color:var(--a-gold);color:#1a1208!important}
    .a-day.active b{color:#1a1208}
    .a-empty{margin-top:18px;padding:26px;border:1px dashed #6b5a3a;border-radius:6px;color:var(--a-mute);text-align:center}
    .a-mv{display:grid;grid-template-columns:110px 1fr;gap:20px;margin-top:18px;padding:18px;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:8px}
    .a-mv img{width:110px;aspect-ratio:2/3;object-fit:cover;border-radius:4px;display:block;transition:transform .3s}
    .a-mv:hover img{transform:scale(1.03)}
    .a-mv h4{margin:0 0 4px;font-size:18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .a-mv h4 a{color:var(--a-text)!important;text-decoration:none}
    .a-mv h4 a:hover{color:var(--a-gold)!important}
    .a-age{background:var(--a-wine);color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:3px}
    .a-meta{color:var(--a-mute);font-size:13px;margin-bottom:6px}
    .a-roomtype{font-size:12px;letter-spacing:1px;color:var(--a-mute);margin:12px 0 8px;text-transform:uppercase}
    .a-slots{display:flex;gap:10px;flex-wrap:wrap}
    .a-slot{min-width:84px;text-align:center;padding:9px 12px;border:1px solid #6b5a3a;border-radius:4px;text-decoration:none;color:var(--a-text)!important;background:#14100c;transition:transform .15s,border-color .15s,box-shadow .15s}
    .a-slot b{display:block;font-size:16px}
    .a-slot small{display:block;font-size:11px;color:var(--a-mute)}
    .a-slot:hover{border-color:var(--a-gold);transform:translateY(-2px);box-shadow:0 8px 20px rgba(230,162,60,.25)}
    .a-slot.past{opacity:.35;pointer-events:none}
    @@media(max-width:700px){
        .a-chero{padding:28px 16px 18px}
        .a-csec{padding:26px 16px 0}
        .a-mv{grid-template-columns:80px 1fr;gap:14px}
        .a-mv img{width:80px}
    }
</style>

<section class="a-chero">
    <h1>@Model.Cinema.Name</h1>
    <p>@Model.Cinema.Address, @Model.Cinema.City.Name</p>
    <p>Hotline: @Model.Cinema.Hotline</p>
    <div>
        @foreach (var g in Model.Cinema.Rooms.GroupBy(r => r.Type).OrderBy(g => g.Key))
        {
            <span class="a-chipseat">@g.Count() phòng @g.Key</span>
        }
    </div>
</section>

<section class="a-csec">
    <h2 class="a-h">Lịch chiếu</h2>

    <div class="a-days">
        @foreach (var day in Model.Days)
        {
            <a class="a-day @(day == Model.SelectedDate ? "active" : "")"
               href="/Cinemas/Details/@Model.Cinema.Id?date=@day.ToString("yyyy-MM-dd")">
                <small>@dow[(int)day.DayOfWeek] · Th@(day.Month)</small>
                <b>@day.Day.ToString("00")</b>
            </a>
        }
    </div>

    @if (Model.Movies.Count == 0)
    {
        <div class="a-empty">Không có suất chiếu trong ngày này.</div>
    }
    else
    {
        foreach (var ms in Model.Movies)
        {
            <div class="a-mv">
                <a href="/Movies/Details/@ms.Movie.Id">
                    <img src="@ms.Movie.PosterUrl" alt="@ms.Movie.Title" loading="lazy" />
                </a>
                <div>
                    <h4>
                        <a href="/Movies/Details/@ms.Movie.Id">@ms.Movie.Title</a>
                        <span class="a-age">@ms.Movie.AgeRating</span>
                    </h4>
                    <div class="a-meta">@(ms.Movie.DurationMin > 0 ? $"{ms.Movie.DurationMin} phút" : "Đang cập nhật")</div>
                    @foreach (var f in ms.Formats)
                    {
                        <div class="a-roomtype">@f.Label</div>
                        <div class="a-slots">
                            @foreach (var s in f.Slots)
                            {
                                <a class="a-slot @(s.Past ? "past" : "")" href="/Booking/Seats/@s.Id">
                                    <b>@s.Time</b>
                                    <small>@((s.Price / 1000).ToString("0"))K</small>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>