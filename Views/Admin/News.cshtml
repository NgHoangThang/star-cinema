@model List<CinemaApp.Models.Article>
@{
    ViewData["Title"] = "Tin tức";
    ViewData["Dark"] = true;
    string status = ViewBag.Status as string ?? "";
    string q = ViewBag.Q as string ?? "";
    int cAll = ViewBag.CountAll;
    int cPub = ViewBag.CountPub;
    int cDraft = ViewBag.CountDraft;

    var chips = new (string Label, string Key, int Count)[]
    {
        ("Tất cả", "", cAll), ("Đã đăng", "published", cPub), ("Nháp", "draft", cDraft)
    };
}

<style>
    .an-head{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap;margin:0 0 20px}
    .an-head .eb{color:var(--a-gold);font-size:12px;letter-spacing:3px}
    .an-head h1{font-size:28px;font-weight:800;margin:4px 0 4px;color:var(--a-text)}
    .an-head p{margin:0;color:var(--a-mute);font-size:14px}
    .an-msg{margin:0 0 16px;padding:12px 16px;border:1px solid var(--a-gold);border-left:4px solid var(--a-gold);border-radius:6px;background:var(--a-bg2);color:var(--a-text);font-size:14px}

    .an-tools{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-bottom:14px}
    .an-chips{display:flex;flex-wrap:wrap;gap:8px}
    .an-chip{padding:8px 16px;border-radius:999px;border:1px solid var(--a-line);background:var(--a-bg2);color:var(--a-mute);font-size:13px;font-weight:600;text-decoration:none;transition:border-color .15s,color .15s,background .15s}
    .an-chip:hover{border-color:#6b5a3a;color:var(--a-gold2)}
    .an-chip.active{border-color:var(--a-gold);color:var(--a-gold);background:rgba(230,162,60,.12)}
    .an-search{display:flex;gap:8px}
    .an-search input{background:#14100c;border:1px solid #6b5a3a;border-radius:8px;color:var(--a-text);padding:8px 12px;font-size:14px;min-width:220px}
    .an-search input:focus{outline:none;border-color:var(--a-gold)}

    .an-card{background:var(--a-bg2);border:1px solid var(--a-line);border-radius:12px;overflow:hidden}
    .an-wrap{overflow-x:auto}
    .an-table{width:100%;min-width:860px;border-collapse:collapse;font-size:14px}
    .an-table th{text-align:left;font-size:11px;letter-spacing:1px;color:var(--a-mute);font-weight:600;padding:12px 14px;border-bottom:1px solid var(--a-line);background:rgba(0,0,0,.2);white-space:nowrap}
    .an-table td{padding:14px;border-bottom:1px solid var(--a-line);color:var(--a-text);vertical-align:middle}
    .an-table tr:last-child td{border-bottom:0}
    .an-table tr:hover td{background:rgba(230,162,60,.03)}
    .an-table small{display:block;color:var(--a-mute);font-size:12px;margin-top:2px}
    .an-title{font-weight:700;color:var(--a-text);max-width:360px}
    .an-nw{white-space:nowrap}
    .an-b{display:inline-block;padding:3px 11px;border-radius:999px;font-size:12px;border:1px solid;white-space:nowrap}
    .an-b.ok{color:#7ee2a0;border-color:#2f7d4f;background:rgba(47,125,79,.12)}
    .an-b.off{color:var(--a-mute);border-color:#4a4034}
    .an-act{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
    .an-act form{margin:0}
    .an-btn{display:inline-block;background:none;border:1px solid #6b5a3a;color:var(--a-gold);border-radius:8px;padding:6px 14px;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none}
    .an-btn:hover{border-color:var(--a-gold);background:rgba(230,162,60,.08);color:var(--a-gold)}
    .an-btn.del{color:#ff8f9d;border-color:#8f2a3a}
    .an-btn.del:hover{background:rgba(164,19,43,.12);border-color:#ff8f9d;color:#ff8f9d}
    .an-empty{padding:48px 16px;text-align:center;color:var(--a-mute);font-size:14px}
</style>

<div class="an-head">
    <div>
        <div class="eb">QUẢN TRỊ</div>
        <h1>Tin tức</h1>
        <p>Viết bài, lưu nháp, đăng hoặc ẩn bài hiện ở trang Tin tức cho khách.</p>
    </div>
    <a class="a-btn" href="/Admin/News/Create">+ Viết bài mới</a>
</div>

@if (TempData["AdminMsg"] is string amsg)
{
    <div class="an-msg">@amsg</div>
}

<div class="an-tools">
    <div class="an-chips">
        @foreach (var c in chips)
        {
            <a class="an-chip @(c.Key == status ? "active" : "")" href="/Admin/News@(c.Key == "" ? "" : "?status=" + c.Key)">@c.Label (@c.Count)</a>
        }
    </div>
    <form class="an-search" method="get" action="/Admin/News">
        @if (status != "") { <input type="hidden" name="status" value="@status" /> }
        <input type="search" name="q" value="@q" placeholder="Tìm theo tiêu đề" />
        <button type="submit" class="an-btn">Tìm</button>
    </form>
</div>

<div class="an-card">
    @if (Model.Count == 0)
    {
        <div class="an-empty">Không có bài viết nào. Bấm "Viết bài mới" để tạo bài đầu tiên.</div>
    }
    else
    {
        <div class="an-wrap">
            <table class="an-table">
                <thead>
                    <tr><th>TIÊU ĐỀ</th><th>NHÓM</th><th>TRẠNG THÁI</th><th>NGÀY ĐĂNG</th><th>SỬA LẦN CUỐI</th><th>THAO TÁC</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                <div class="an-title">@a.Title</div>
                                <small>/News/@a.Slug</small>
                            </td>
                            <td class="an-nw">@a.Category</td>
                            <td><span class="an-b @(a.IsPublished ? "ok" : "off")">@(a.IsPublished ? "Đã đăng" : "Nháp")</span></td>
                            <td class="an-nw">@(a.PublishedAt?.AddHours(7).ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td class="an-nw">@a.UpdatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="an-act">
                                    <a class="an-btn" href="/Admin/News/Edit/@a.Id">Sửa</a>
                                    <form asp-controller="AdminNews" asp-action="Toggle" asp-route-id="@a.Id" method="post">
                                        <button type="submit" class="an-btn">@(a.IsPublished ? "Ẩn" : "Đăng")</button>
                                    </form>
                                    @if (a.IsPublished)
                                    {
                                        <a class="an-btn" href="/News/@a.Slug" target="_blank" rel="noopener">Xem</a>
                                    }
                                    <form asp-controller="AdminNews" asp-action="Delete" asp-route-id="@a.Id" method="post"
                                          onsubmit="return confirm('Xóa bài này? Không khôi phục được.');">
                                        <button type="submit" class="an-btn del">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>