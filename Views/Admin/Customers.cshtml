@using CinemaApp.Controllers
@model List<AdminCustomerRow>
@{
    ViewData["Title"] = "Khách hàng";
    ViewData["Dark"] = true;
    var msg = TempData["AdminMsg"] as string;
    string q = ViewBag.Q as string ?? "";
    string vw = ViewBag.View as string ?? "blocked";
    int pageNo = ViewBag.Page;
    int pages = ViewBag.Pages;
    int total = ViewBag.Total;
    var now = DateTime.UtcNow;
    string Link(int p, string v) => "/Admin/Customers?page=" + p + "&view=" + v + (q.Length > 0 ? "&q=" + Uri.EscapeDataString(q) : "");
}

<style>
    .cu-head{margin:0 0 16px;max-width:1000px}
    .cu-head .eb{color:var(--a-gold);font-size:12px;letter-spacing:3px}
    .cu-head h1{font-size:28px;font-weight:800;margin:4px 0 4px;color:var(--a-text)}
    .cu-head p{margin:0;font-size:14px;color:var(--a-mute);line-height:1.6}
    .cu-alert{max-width:1000px;margin:0 0 14px;padding:12px 16px;border:1px solid #6b5a3a;border-left:4px solid var(--a-gold);border-radius:8px;background:var(--a-bg2);color:var(--a-text);font-size:14px}
    .cu-search{display:flex;gap:10px;max-width:1000px;margin:0 0 12px}
    .cu-search input[type=text]{flex:1;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:8px;color:var(--a-text);padding:10px 12px;font-size:14px}
    .cu-chips{display:flex;gap:8px;max-width:1000px;margin:0 0 14px;flex-wrap:wrap}
    .cu-chips a{border:1px solid #6b5a3a;border-radius:999px;padding:5px 14px;font-size:13px;color:var(--a-mute);text-decoration:none}
    .cu-chips a.on{border-color:var(--a-gold);color:var(--a-gold);background:rgba(230,162,60,.1)}
    .cu-count{max-width:1000px;margin:0 0 10px;font-size:13px;color:var(--a-mute)}
    .cu-table{width:100%;max-width:1000px;border-collapse:collapse;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:12px;overflow:hidden}
    .cu-table th{text-align:left;font-size:12px;letter-spacing:1px;color:var(--a-mute);font-weight:600;padding:12px 14px;border-bottom:1px solid var(--a-line)}
    .cu-table td{padding:10px 14px;border-bottom:1px solid var(--a-line);font-size:14px;color:var(--a-text);vertical-align:middle}
    .cu-table tr:last-child td{border-bottom:0}
    .cu-name{font-weight:700}
    .cu-sub{font-size:12px;color:var(--a-mute)}
    .cu-bad{color:#ff8a98;font-weight:700}
    .cu-ok{color:var(--a-mute)}
    .cu-act form{margin:0}
    .cu-link{background:none;border:0;color:var(--a-gold);text-decoration:underline;cursor:pointer;font-size:13px;padding:0}
    .cu-link.del{color:#ff8a98}
    .cu-pager{display:flex;gap:10px;align-items:center;max-width:1000px;margin:14px 0 0;font-size:13px;color:var(--a-mute)}
    .cu-pager a{border:1px solid #6b5a3a;border-radius:6px;padding:5px 12px;color:var(--a-gold);text-decoration:none}
    @@media(max-width:700px){
        .cu-table th:nth-child(2),.cu-table td:nth-child(2){display:none}
    }
</style>

<div class="cu-head">
    <div class="eb">QUẢN TRỊ · KHÁCH HÀNG</div>
    <h1>Khách hàng</h1>
    <p>Khách giữ vé trả tiền mặt nhưng nhiều lần không đến thanh toán sẽ bị khóa chọn tiền mặt tạm thời (vẫn đặt vé bằng chuyển khoản được). Ở đây bạn xem danh sách, mở khóa khi khách giải trình, hoặc khóa tay khi cần.</p>
</div>

@if (!string.IsNullOrEmpty(msg))
{
    <div class="cu-alert">@msg</div>
}

<form method="get" action="/Admin/Customers" class="cu-search">
    <input type="text" name="q" value="@q" placeholder="Tìm theo email hoặc họ tên (tìm trong tất cả khách)" />
    <input type="hidden" name="view" value="@vw" />
    <button type="submit" class="a-btn ghost">Tìm</button>
</form>

<div class="cu-chips">
    <a href="@Link(1, "blocked")" class="@(vw == "blocked" && q.Length == 0 ? "on" : "")">Đang bị khóa</a>
    <a href="@Link(1, "warn")" class="@(vw == "warn" && q.Length == 0 ? "on" : "")">Có vi phạm</a>
    <a href="@Link(1, "all")" class="@(vw == "all" && q.Length == 0 ? "on" : "")">Tất cả</a>
</div>
<div class="cu-count">@total khách</div>

<table class="cu-table">
    <thead>
        <tr><th>KHÁCH</th><th>HẠNG · ĐIỂM</th><th>VI PHẠM TIỀN MẶT</th><th>TRẠNG THÁI</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            bool blocked = c.BlockedUntil > now;
            <tr>
                <td>
                    <div class="cu-name">@(string.IsNullOrWhiteSpace(c.FullName) ? c.Email : c.FullName)</div>
                    <div class="cu-sub">@c.Email · @c.PaidOrders đơn đã thanh toán</div>
                </td>
                <td>@c.Tier · @c.Points.ToString("N0")</td>
                <td>@c.NoShow lần</td>
                <td>
                    @if (blocked)
                    {
                        <span class="cu-bad">Khóa đến @c.BlockedUntil!.Value.AddHours(7).ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                        <span class="cu-ok">Bình thường</span>
                    }
                </td>
                <td class="cu-act">
                    @if (blocked || c.NoShow > 0)
                    {
                        <form method="post" action="/Admin/Customers/Unblock/@c.Id" onsubmit="return confirm('Mở khóa trả tiền mặt và xóa số lần vi phạm của khách này?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="q" value="@q" />
                            <input type="hidden" name="view" value="@vw" />
                            <button type="submit" class="cu-link">Mở khóa</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="/Admin/Customers/Block/@c.Id" onsubmit="return confirm('Khóa trả tiền mặt 30 ngày cho khách này?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="q" value="@q" />
                            <input type="hidden" name="view" value="@vw" />
                            <button type="submit" class="cu-link del">Khóa 30 ngày</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" style="text-align:center;color:var(--a-mute)">Không có khách phù hợp.</td></tr>
        }
    </tbody>
</table>

@if (pages > 1)
{
    <div class="cu-pager">
        @if (pageNo > 1) { <a href="@Link(pageNo - 1, vw)">‹ Trước</a> }
        <span>Trang @pageNo / @pages</span>
        @if (pageNo < pages) { <a href="@Link(pageNo + 1, vw)">Sau ›</a> }
    </div>
}