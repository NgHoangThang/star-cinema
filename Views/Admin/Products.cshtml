@using CinemaApp.Controllers
@model List<AdminProductRow>
@{
    ViewData["Title"] = "Combo bắp nước";
    ViewData["Dark"] = true;
    var msg = TempData["AdminMsg"] as string;
}

<style>
    .pr-head{margin:0 0 16px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;max-width:1000px}
    .pr-head .eb{color:var(--a-gold);font-size:12px;letter-spacing:3px}
    .pr-head h1{font-size:28px;font-weight:800;margin:4px 0 4px;color:var(--a-text)}
    .pr-head p{margin:0;font-size:14px;color:var(--a-mute)}
    .pr-alert{max-width:1000px;margin:0 0 14px;padding:12px 16px;border:1px solid #6b5a3a;border-left:4px solid var(--a-gold);border-radius:8px;background:var(--a-bg2);color:var(--a-text);font-size:14px}
    .pr-table{width:100%;max-width:1000px;border-collapse:collapse;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:12px;overflow:hidden}
    .pr-table th{text-align:left;font-size:12px;letter-spacing:1px;color:var(--a-mute);font-weight:600;padding:12px 14px;border-bottom:1px solid var(--a-line)}
    .pr-table td{padding:10px 14px;border-bottom:1px solid var(--a-line);font-size:14px;color:var(--a-text);vertical-align:middle}
    .pr-table tr:last-child td{border-bottom:0}
    .pr-table tr.off td{opacity:.55}
    .pr-img{width:56px;height:56px;object-fit:cover;border-radius:8px;border:1px solid var(--a-line);background:#14100c;display:block}
    .pr-name{font-weight:700}
    .pr-sub{font-size:12px;color:var(--a-mute)}
    .pr-badge{display:inline-block;margin-left:6px;padding:1px 8px;border-radius:999px;border:1px solid var(--a-gold);color:var(--a-gold);font-size:11px;font-weight:600}
    .pr-act{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .pr-act form{margin:0}
    .pr-link{background:none;border:0;color:var(--a-gold);text-decoration:underline;cursor:pointer;font-size:13px;padding:0}
    .pr-link.del{color:#ff8a98}
    @@media(max-width:700px){
        .pr-table th:nth-child(4),.pr-table td:nth-child(4){display:none}
    }
</style>

<div class="pr-head">
    <div>
        <div class="eb">QUẢN TRỊ · BẮP NƯỚC</div>
        <h1>Combo bắp nước</h1>
        <p>Sản phẩm hiện ở bước chọn bắp nước khi khách đặt vé. Đổi giá chỉ áp dụng cho đơn mới; đơn cũ giữ giá lúc mua. Sản phẩm đã có trong đơn thì chỉ ẩn được, không xóa.</p>
    </div>
    <a href="/Admin/Products/New" class="a-btn">+ Thêm sản phẩm</a>
</div>

@if (!string.IsNullOrEmpty(msg))
{
    <div class="pr-alert">@msg</div>
}

<table class="pr-table">
    <thead><tr><th></th><th>SẢN PHẨM</th><th>GIÁ</th><th>ĐÃ BÁN</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr class="@(p.IsActive ? "" : "off")">
            <td>
                @if (!string.IsNullOrEmpty(p.ImageUrl)) { <img class="pr-img" src="@p.ImageUrl" alt="" /> }
                else { <div class="pr-img"></div> }
            </td>
            <td>
                <div class="pr-name">@p.Name@if (!string.IsNullOrEmpty(p.Badge)) { <span class="pr-badge">@p.Badge</span> }</div>
                <div class="pr-sub">@p.Description</div>
                <div class="pr-sub">Thứ tự @p.SortOrder · @(p.IsActive ? "đang bán" : "đang ẩn")</div>
            </td>
            <td>@p.Price.ToString("N0") đ</td>
            <td>@p.SoldQty<div class="pr-sub">trong đơn đã thanh toán</div></td>
            <td>
                <div class="pr-act">
                    <a class="pr-link" href="/Admin/Products/Edit/@p.Id">Sửa</a>
                    <form method="post" action="/Admin/Products/Toggle/@p.Id">
                        @Html.AntiForgeryToken()
                        <button class="pr-link" type="submit">@(p.IsActive ? "Ẩn" : "Bán lại")</button>
                    </form>
                    @if (p.UsedInOrders == 0)
                    {
                        <form method="post" action="/Admin/Products/Delete/@p.Id" onsubmit="return confirm('Xóa sản phẩm này?')">
                            @Html.AntiForgeryToken()
                            <button class="pr-link del" type="submit">Xóa</button>
                        </form>
                    }
                </div>
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="5" style="color:var(--a-mute)">Chưa có sản phẩm nào.</td></tr>
    }
    </tbody>
</table>