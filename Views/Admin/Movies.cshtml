@using CinemaApp.Controllers
@using CinemaApp.Models
@model List<AdminMovieRow>
@{
    ViewData["Title"] = "Phim";
    ViewData["Dark"] = true;
    var msg = TempData["AdminMsg"] as string;
    string q = ViewBag.Q as string ?? "";
    string status = ViewBag.Status as string ?? "";
    int pageNo = ViewBag.Page;
    int pages = ViewBag.Pages;
    int total = ViewBag.Total;
    var ratings = new[] { "P", "K", "T13", "T16", "T18" };
    string Link(int p, string? st) => "/Admin/Movies?page=" + p + (q.Length > 0 ? "&q=" + Uri.EscapeDataString(q) : "") + (!string.IsNullOrEmpty(st) ? "&status=" + st : "");
}

<style>
    .mv-head{margin:0 0 16px;display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;max-width:1000px}
    .mv-head .eb{color:var(--a-gold);font-size:12px;letter-spacing:3px}
    .mv-head h1{font-size:28px;font-weight:800;margin:4px 0 4px;color:var(--a-text)}
    .mv-head p{margin:0;font-size:14px;color:var(--a-mute)}
    .mv-alert{max-width:1000px;margin:0 0 14px;padding:12px 16px;border:1px solid #6b5a3a;border-left:4px solid var(--a-gold);border-radius:8px;background:var(--a-bg2);color:var(--a-text);font-size:14px}
    .mv-search{display:flex;gap:10px;max-width:1000px;margin:0 0 12px}
    .mv-search input[type=text]{flex:1;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:8px;color:var(--a-text);padding:10px 12px;font-size:14px}
    .mv-chips{display:flex;gap:8px;max-width:1000px;margin:0 0 14px;flex-wrap:wrap}
    .mv-chips a{border:1px solid #6b5a3a;border-radius:999px;padding:5px 14px;font-size:13px;color:var(--a-mute);text-decoration:none}
    .mv-chips a.on{border-color:var(--a-gold);color:var(--a-gold);background:rgba(230,162,60,.1)}
    .mv-count{max-width:1000px;margin:0 0 10px;font-size:13px;color:var(--a-mute)}
    .mv-table{width:100%;max-width:1000px;border-collapse:collapse;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:12px;overflow:hidden}
    .mv-table th{text-align:left;font-size:12px;letter-spacing:1px;color:var(--a-mute);font-weight:600;padding:12px 14px;border-bottom:1px solid var(--a-line)}
    .mv-table td{padding:10px 14px;border-bottom:1px solid var(--a-line);font-size:14px;color:var(--a-text);vertical-align:middle}
    .mv-table tr:last-child td{border-bottom:0}
    .mv-poster{width:44px;height:64px;object-fit:cover;border-radius:4px;border:1px solid var(--a-line);background:#14100c;display:block}
    .mv-title{font-weight:700}
    .mv-sub{font-size:12px;color:var(--a-mute)}
    .mv-sel{background:#14100c;border:1px solid #6b5a3a;color:var(--a-gold);border-radius:6px;padding:6px 10px;font-size:14px;font-weight:700}
    .mv-act{display:flex;gap:8px;align-items:center}
    .mv-act form{margin:0}
    .mv-link{background:none;border:0;color:var(--a-gold);text-decoration:underline;cursor:pointer;font-size:13px;padding:0}
    .mv-link.del{color:#ff8a98}
    .mv-pager{display:flex;gap:10px;align-items:center;max-width:1000px;margin:14px 0 0;font-size:13px;color:var(--a-mute)}
    .mv-pager a{border:1px solid #6b5a3a;border-radius:6px;padding:5px 12px;color:var(--a-gold);text-decoration:none}
    @@media(max-width:700px){
        .mv-table th:nth-child(3),.mv-table td:nth-child(3){display:none}
    }
</style>

<div class="mv-head">
    <div>
        <div class="eb">QUẢN TRỊ · PHIM</div>
        <h1>Quản lý phim</h1>
        <p>Thêm, sửa, xóa phim; đổi nhanh nhãn độ tuổi ở cột cuối. Phim đã có suất chiếu thì không xóa được.</p>
    </div>
    <a href="/Admin/Movies/New" class="a-btn">+ Thêm phim</a>
</div>

@if (!string.IsNullOrEmpty(msg))
{
    <div class="mv-alert">@msg</div>
}

<form method="get" action="/Admin/Movies" class="mv-search">
    <input type="text" name="q" value="@q" placeholder="Tìm theo tên phim" />
    @if (status.Length > 0) { <input type="hidden" name="status" value="@status" /> }
    <button type="submit" class="a-btn ghost">Tìm</button>
</form>

<div class="mv-chips">
    <a href="@Link(1, null)" class="@(status == "" ? "on" : "")">Tất cả</a>
    <a href="@Link(1, "NowShowing")" class="@(status == "NowShowing" ? "on" : "")">Đang chiếu</a>
    <a href="@Link(1, "ComingSoon")" class="@(status == "ComingSoon" ? "on" : "")">Sắp chiếu</a>
    <a href="@Link(1, "Ended")" class="@(status == "Ended" ? "on" : "")">Ngừng chiếu</a>
</div>
<div class="mv-count">@total phim</div>

<table class="mv-table">
    <thead>
        <tr><th></th><th>PHIM</th><th>KHỞI CHIẾU</th><th>NHÃN ĐỘ TUỔI</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td style="width:64px"><img class="mv-poster" src="@m.PosterUrl" alt="" loading="lazy" /></td>
                <td>
                    <div class="mv-title">@m.Title</div>
                    <div class="mv-sub">@(m.Status == "NowShowing" ? "Đang chiếu" : m.Status == "Ended" ? "Ngừng chiếu" : "Sắp chiếu") · @m.Showtimes suất chiếu</div>
                </td>
                <td>@m.Release</td>
                <td>
                    <form method="post" action="/Admin/Movies/Age/@m.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="q" value="@q" />
                        <select name="age" class="mv-sel" onchange="this.form.submit()" title="@AgeRatings.Describe(m.AgeRating)">
                            @foreach (var r in ratings)
                            {
                                <option value="@r" selected="@(AgeRatings.Code(m.AgeRating) == r)">@r</option>
                            }
                        </select>
                    </form>
                </td>
                <td>
                    <div class="mv-act">
                        <a class="mv-link" href="/Admin/Movies/Edit/@m.Id">Sửa</a>
                        @if (m.Showtimes == 0)
                        {
                            <form method="post" action="/Admin/Movies/Delete/@m.Id" onsubmit="return confirm('Xóa phim này? Không khôi phục được.')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="mv-link del">Xóa</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" style="text-align:center;color:var(--a-mute)">Không có phim phù hợp.</td></tr>
        }
    </tbody>
</table>

@if (pages > 1)
{
    <div class="mv-pager">
        @if (pageNo > 1) { <a href="@Link(pageNo - 1, status)">‹ Trước</a> }
        <span>Trang @pageNo / @pages</span>
        @if (pageNo < pages) { <a href="@Link(pageNo + 1, status)">Sau ›</a> }
    </div>
}