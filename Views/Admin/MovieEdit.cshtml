@using CinemaApp.Controllers
@using CinemaApp.Models
@model MovieForm
@{
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Thêm phim" : "Sửa phim";
    ViewData["Dark"] = true;
    var genres = (List<Genre>)ViewBag.Genres;
    var ratings = (string[])ViewBag.Ratings;
    string? error = ViewBag.Error as string;
}

<style>
    .mve-head{margin:0 0 16px;max-width:900px}
    .mve-head .eb{color:var(--a-gold);font-size:12px;letter-spacing:3px}
    .mve-head h1{font-size:28px;font-weight:800;margin:4px 0 4px;color:var(--a-text)}
    .mve-err{max-width:900px;margin:0 0 14px;padding:12px 16px;border:1px solid var(--a-wine);border-left:4px solid var(--a-wine);border-radius:8px;background:var(--a-bg2);color:#ffd9de;font-size:14px}
    .mve-card{max-width:900px;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:12px;padding:22px 24px}
    .mve-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px 20px}
    .mve-full{grid-column:1/-1}
    .mve-f label{display:block;font-size:12px;letter-spacing:1px;color:var(--a-mute);margin:0 0 6px}
    .mve-f input[type=text],.mve-f input[type=number],.mve-f input[type=date],.mve-f select,.mve-f textarea{width:100%;box-sizing:border-box;background:#14100c;border:1px solid #6b5a3a;border-radius:6px;color:var(--a-text);padding:9px 12px;font-size:14px}
    .mve-f textarea{min-height:110px;resize:vertical;font-family:inherit}
    .mve-f input:focus,.mve-f select:focus,.mve-f textarea:focus{outline:none;border-color:var(--a-gold)}
    .mve-hint{font-size:12px;color:var(--a-mute);margin-top:4px}
    .mve-poster{display:flex;gap:16px;align-items:flex-start}
    .mve-poster img{width:90px;height:130px;object-fit:cover;border-radius:6px;border:1px solid var(--a-line);background:#14100c}
    .mve-poster .rest{flex:1;min-width:0;display:grid;gap:10px}
    .mve-genres{display:flex;flex-wrap:wrap;gap:8px}
    .mve-genres label{display:inline-flex;gap:6px;align-items:center;margin:0;padding:5px 12px;border:1px solid #6b5a3a;border-radius:999px;font-size:13px;letter-spacing:0;color:var(--a-text);cursor:pointer}
    .mve-genres label:has(input:checked){border-color:var(--a-gold);background:rgba(230,162,60,.12);color:var(--a-gold)}
    .mve-genres input{accent-color:#e6a23c}
    .mve-actions{display:flex;gap:12px;margin-top:22px;align-items:center}
    @@media(max-width:700px){
        .mve-grid{grid-template-columns:1fr}
        .mve-poster{flex-direction:column}
    }
</style>

<div class="mve-head">
    <div class="eb">QUẢN TRỊ · PHIM</div>
    <h1>@(isNew ? "Thêm phim mới" : "Sửa phim")</h1>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="mve-err">@error</div>
}

<form method="post" action="/Admin/Movies/Save" enctype="multipart/form-data" class="mve-card">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mve-grid">
        <div class="mve-f mve-full">
            <label>TÊN PHIM *</label>
            <input type="text" name="Title" value="@Model.Title" maxlength="200" required />
        </div>

        <div class="mve-f">
            <label>THỜI LƯỢNG (PHÚT) *</label>
            <input type="number" name="DurationMin" value="@Model.DurationMin" min="1" max="600" required />
            <div class="mve-hint">Đổi thời lượng không làm đổi giờ kết thúc của suất chiếu đã tạo.</div>
        </div>
        <div class="mve-f">
            <label>NGÀY KHỞI CHIẾU *</label>
            <input type="date" name="ReleaseDate" value="@Model.ReleaseDate" required />
        </div>

        <div class="mve-f">
            <label>NHÃN ĐỘ TUỔI *</label>
            <select name="AgeRating">
                @foreach (var r in ratings)
                {
                    <option value="@r" selected="@(AgeRatings.Code(Model.AgeRating) == r)">@r · @AgeRatings.Describe(r)</option>
                }
            </select>
            <div class="mve-hint">Vé trẻ em chỉ bán được cho phim nhãn P hoặc K.</div>
        </div>
        <div class="mve-f">
            <label>TRẠNG THÁI *</label>
            <select name="Status">
                <option value="NowShowing" selected="@(Model.Status == "NowShowing")">Đang chiếu</option>
                <option value="ComingSoon" selected="@(Model.Status == "ComingSoon")">Sắp chiếu</option>
                <option value="Ended" selected="@(Model.Status == "Ended")">Ngừng chiếu</option>
            </select>
        </div>

        <div class="mve-f">
            <label>ĐẠO DIỄN</label>
            <input type="text" name="Director" value="@Model.Director" maxlength="200" />
        </div>
        <div class="mve-f">
            <label>QUỐC GIA</label>
            <input type="text" name="Country" value="@Model.Country" maxlength="100" />
        </div>

        <div class="mve-f mve-full">
            <label>DIỄN VIÊN</label>
            <input type="text" name="Cast" value="@Model.Cast" maxlength="500" />
        </div>

        <div class="mve-f mve-full">
            <label>THỂ LOẠI</label>
            <div class="mve-genres">
                @foreach (var g in genres)
                {
                    <label><input type="checkbox" name="GenreIds" value="@g.Id" checked="@Model.GenreIds.Contains(g.Id)" />@g.Name</label>
                }
            </div>
        </div>

        <div class="mve-f mve-full">
            <label>NỘI DUNG PHIM</label>
            <textarea name="Synopsis" maxlength="4000">@Model.Synopsis</textarea>
        </div>

        <div class="mve-f mve-full">
            <label>POSTER *</label>
            <div class="mve-poster">
                @if (!string.IsNullOrEmpty(Model.PosterUrl)) { <img src="@Model.PosterUrl" alt="" /> }
                <div class="rest">
                    <div>
                        <input type="file" name="PosterFile" accept="image/jpeg,image/png,image/webp" />
                        <div class="mve-hint">Tải ảnh JPG, PNG hoặc WEBP, tối đa 3 MB. Có tải ảnh thì ảnh này được dùng thay cho đường dẫn bên dưới.</div>
                    </div>
                    <div>
                        <input type="text" name="PosterUrl" value="@Model.PosterUrl" maxlength="500" placeholder="Hoặc dán đường dẫn ảnh (https://...)" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mve-f">
            <label>ẢNH NỀN (BACKDROP)</label>
            <input type="text" name="BackdropUrl" value="@Model.BackdropUrl" maxlength="500" placeholder="https://..." />
        </div>
        <div class="mve-f">
            <label>TRAILER</label>
            <input type="text" name="TrailerUrl" value="@Model.TrailerUrl" maxlength="500" placeholder="https://..." />
        </div>
    </div>

    <div class="mve-actions">
        <button type="submit" class="a-btn">@(isNew ? "Thêm phim" : "Lưu thay đổi")</button>
        <a href="/Admin/Movies" class="a-btn ghost">Hủy</a>
    </div>
</form>