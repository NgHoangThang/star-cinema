@using CinemaApp.Controllers
@model NewsDetailView
@{
    var a = Model.Article;
    ViewData["Title"] = a.Title;
    ViewData["Dark"] = true;

    // Nội dung dạng chữ thường: dòng trống = đoạn mới. Razor tự mã hóa nên không chèn được HTML.
    var paras = (a.Body ?? "").Replace("\r\n", "\n")
        .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<style>
    .nw-art{max-width:780px;margin:0 auto;padding:30px 24px 20px}
    .nw-crumb{font-size:13px;color:var(--a-mute);margin-bottom:18px}
    .nw-crumb a{color:var(--a-gold);text-decoration:none}
    .nw-crumb a:hover{color:var(--a-gold2)}
    .nw-tag{display:inline-block;font-size:11px;letter-spacing:1px;color:var(--a-gold);border:1px solid #6b5a3a;border-radius:999px;padding:2px 10px}
    .nw-art h1{font-size:clamp(26px,4vw,38px);font-weight:800;line-height:1.25;margin:12px 0 8px;color:var(--a-text)}
    .nw-meta{font-size:13px;color:#7d7261;margin-bottom:22px}
    .nw-cover{width:100%;border-radius:12px;display:block;margin-bottom:24px;border:1px solid var(--a-line)}
    .nw-sum{font-size:17px;line-height:1.65;color:var(--a-gold2);margin:0 0 22px;padding-left:14px;border-left:3px solid var(--a-gold)}
    .nw-body p{font-size:16px;line-height:1.8;color:var(--a-text);margin:0 0 16px;white-space:pre-line}
    .nw-rel{max-width:1100px;margin:0 auto;padding:10px 24px 60px}
    .nw-rel h2{font-size:20px;font-weight:800;margin:30px 0 14px;color:var(--a-text);padding-left:12px;border-left:4px solid var(--a-gold)}
    .nw-relgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
    .nw-relcard{display:block;background:var(--a-bg2);border:1px solid var(--a-line);border-radius:12px;padding:14px 16px;text-decoration:none;transition:border-color .15s}
    .nw-relcard:hover{border-color:var(--a-gold)}
    .nw-relcard b{display:block;color:var(--a-text);font-size:15px;line-height:1.4;margin-bottom:6px}
    .nw-relcard span{font-size:12px;color:#7d7261}
    .nw-back{display:inline-block;margin-top:10px;color:var(--a-gold);text-decoration:none;font-weight:700;font-size:14px}
    .nw-back:hover{color:var(--a-gold2)}
    @@media(max-width:900px){.nw-art{padding:20px 16px 10px}.nw-rel{padding:10px 16px 50px}}
</style>

<article class="nw-art">
    <div class="nw-crumb"><a href="/News">Tin tức</a> / @a.Category</div>
    <span class="nw-tag">@a.Category</span>
    <h1>@a.Title</h1>
    <div class="nw-meta">@(a.PublishedAt?.AddHours(7).ToString("dd/MM/yyyy"))</div>

    @if (!string.IsNullOrEmpty(a.CoverUrl))
    {
        <img class="nw-cover" src="@a.CoverUrl" alt="@a.Title" />
    }
    @if (!string.IsNullOrWhiteSpace(a.Summary))
    {
        <p class="nw-sum">@a.Summary</p>
    }

    <div class="nw-body">
        @foreach (var p in paras)
        {
            <p>@p</p>
        }
    </div>

    <a class="nw-back" href="/News">← Tất cả tin tức</a>
</article>

@if (Model.Related.Count > 0)
{
    <section class="nw-rel">
        <h2>Bài viết khác</h2>
        <div class="nw-relgrid">
            @foreach (var r in Model.Related)
            {
                <a class="nw-relcard" href="/News/@r.Slug">
                    <b>@r.Title</b>
                    <span>@r.Category · @(r.PublishedAt?.AddHours(7).ToString("dd/MM/yyyy"))</span>
                </a>
            }
        </div>
    </section>
}