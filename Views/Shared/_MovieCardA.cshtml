@model CinemaApp.Models.Movie

<div class="a-card">
    <div class="poster">
        <a href="/Movies/Details/@Model.Id"><img src="@Model.PosterUrl" alt="@Model.Title" loading="lazy" /></a>
        <span class="badge">@Model.AgeRating</span>
        @if (!string.IsNullOrEmpty(Model.TrailerUrl))
        {
            <button type="button" class="play" data-bs-toggle="modal" data-bs-target="#trailerModal"
                    data-trailer="@Model.TrailerUrl" aria-label="Xem trailer @Model.Title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </button>
        }
    </div>
    <div class="t"><a href="/Movies/Details/@Model.Id" title="@Model.Title">@Model.Title</a></div>
    <div class="m">@(Model.DurationMin > 0 ? $"{Model.DurationMin} phút" : "Đang cập nhật") · @Model.ReleaseDate.ToString("dd/MM/yyyy")</div>
    <div style="margin-top:8px">
        @if (Model.Status == "NowShowing")
        {
            <a href="/Movies/Details/@Model.Id#lich-chieu" class="a-btn" style="padding:7px 16px;font-size:13px">Mua vé</a>
        }
        else
        {
            <a href="/Movies/Details/@Model.Id" class="a-btn ghost" style="padding:7px 16px;font-size:13px">Chi tiết</a>
        }
    </div>
</div>