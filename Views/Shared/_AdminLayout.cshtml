@{
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    bool Starts(params string[] prefixes) => prefixes.Any(p => path.StartsWith(p));

    const string icoGrid = "<rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1.5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1.5\"/>";
    const string icoReceipt = "<path d=\"M6 3h12v18l-3-2-3 2-3-2-3 2z\"/><path d=\"M9 8h6M9 12h6\"/>";
    const string icoScan = "<path d=\"M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3\"/><path d=\"M4 12h16\"/>";
    const string icoTag = "<path d=\"M3 4h8l9.6 9.6a2 2 0 010 2.8l-4.2 4.2a2 2 0 01-2.8 0L4 11V4z\"/><circle cx=\"8\" cy=\"8.5\" r=\"1.4\"/>";
    const string icoLog = "<path d=\"M8 4h8a2 2 0 012 2v14l-3-2-3 2-3-2-3 2V6a2 2 0 012-2z\"/><path d=\"M9 9h6M9 13h4\"/>";
    const string icoUsers = "<circle cx=\"9\" cy=\"8\" r=\"3.2\"/><path d=\"M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M16 5.5a3 3 0 010 5.8M18 14c2 .6 3 2.2 3 4\"/>";
    const string icoHome = "<path d=\"M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z\"/>";
    const string icoShield = "<path d=\"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z\"/><path d=\"M9 12l2 2 4-4\"/>";

    var groups = new (string Title, (string Label, string Href, bool Active, string Icon)[] Items)[]
    {
        ("TỔNG QUAN", new[] {
            ("Tổng quan", "/Admin", path == "/admin" || path == "/admin/index", icoGrid),
            ("Báo cáo doanh thu", "/Admin/Revenue", Starts("/admin/revenue"), "<path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/>") }),
        ("BÁN VÉ", new[] {
            ("Đơn hàng", "/Admin/Orders", Starts("/admin/orders", "/admin/approve", "/admin/reject"), icoReceipt),
            ("Khách hàng", "/Admin/Customers", Starts("/admin/customers"), icoUsers),
            ("Quét vé", "/Admin/Scan", Starts("/admin/scan", "/admin/ticket"), icoScan) }),
        ("NỘI DUNG", new[] {
            ("Rạp & phòng", "/Admin/Cinemas", Starts("/admin/cinemas"), "<path d=\"M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6\"/>"),
            ("Suất chiếu", "/Admin/Showtimes", Starts("/admin/showtimes"), "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>"),
            ("Phim", "/Admin/Movies", Starts("/admin/movies"), "<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4\"/>"),
            ("Combo bắp nước", "/Admin/Products", Starts("/admin/products"), "<path d=\"M5 8h14l-1.5 12h-11zM8 8l1-4h6l1 4\"/>") }),
        ("KHUYẾN MÃI", new[] {
            ("Mã giảm giá", "/Admin/Vouchers", Starts("/admin/voucher"), icoTag) }),
        ("HỆ THỐNG", new[] {
            ("Nhân viên", "/Admin/Staff", Starts("/admin/staff"), icoUsers),
            ("Bảo mật (2 lớp)", "/Account/TwoFactor", Starts("/account/twofactor"), icoShield),
            ("Nhật ký thao tác", "/Admin/Audit", Starts("/admin/audit"), icoLog) })
    };

    // Nhân viên rạp chỉ thấy mục Quét vé và Bảo mật
    bool isAdmin = User.IsInRole("Admin");
    if (!isAdmin)
    {
        groups = new (string Title, (string Label, string Href, bool Active, string Icon)[] Items)[]
        {
            ("BÁN VÉ", new[] {
                ("Quét vé", "/Admin/Scan", Starts("/admin/scan", "/admin/ticket"), icoScan) }),
            ("TÀI KHOẢN", new[] {
                ("Bảo mật (2 lớp)", "/Account/TwoFactor", Starts("/account/twofactor"), icoShield) })
        };
    }

    string who = User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e0c0a" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <title>@ViewData["Title"] - Quản trị Star Cinema</title>
    <script>document.documentElement.classList.add('js');</script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/star.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/star-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/star-light.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/star-a.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/star-admin.css" asp-append-version="true" />
</head>
<body class="st ad">
<div class="ad-shell">

    <aside class="ad-side" id="ad-side">
        <a class="ad-brand" href="/Admin" aria-label="Star Cinema quản trị">
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
                <defs>
                    <linearGradient id="adg" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#ffd86b" />
                        <stop offset="1" stop-color="#ff9f1a" />
                    </linearGradient>
                </defs>
                <polygon points="12,2 14.9,8.6 22,9.3 16.6,14 18.2,21 12,17.3 5.8,21 7.4,14 2,9.3 9.1,8.6" fill="url(#adg)" />
            </svg>
            <span>STAR<b>CINEMA</b><small>QUẢN TRỊ</small></span>
        </a>

        @foreach (var g in groups)
        {
            <div class="ad-group">
                <h6>@g.Title</h6>
                @foreach (var it in g.Items)
                {
                    <a class="ad-link @(it.Active ? "active" : "")" href="@it.Href">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(it.Icon)</svg>
                        <span>@it.Label</span>
                    </a>
                }
            </div>
        }

        <div class="ad-side-foot">
            <a class="ad-link" href="/">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(icoHome)</svg>
                <span>Về trang bán vé</span>
            </a>
        </div>
    </aside>
    <div class="ad-overlay" id="ad-overlay"></div>

    <div class="ad-main">
        <header class="ad-top">
            <button type="button" class="ad-burger" id="ad-burger" aria-label="Mở menu quản trị">
                <span></span><span></span><span></span>
            </button>
            <div class="ad-crumb">Quản trị <i>/</i> <b>@ViewData["Title"]</b></div>
            <div class="ad-top-r">
                <span class="ad-user" title="@who">@who</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="ad-out">Đăng xuất</button>
                </form>
            </div>
        </header>

        <main class="ad-content">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/star.js" asp-append-version="true"></script>
<script>
    (function () {
        var side = document.getElementById('ad-side');
        var btn = document.getElementById('ad-burger');
        var ov = document.getElementById('ad-overlay');
        function set(open) { side.classList.toggle('open', open); ov.classList.toggle('open', open); }
        btn.addEventListener('click', function () { set(!side.classList.contains('open')); });
        ov.addEventListener('click', function () { set(false); });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>