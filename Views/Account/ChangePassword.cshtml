@model CinemaApp.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_AuthLayout";
    ViewData["SideTitle"] = "Bảo vệ tài khoản";
    ViewData["SideText"] = "Nên đổi mật khẩu định kỳ và không dùng chung với trang khác.";
}

<h1>Đổi mật khẩu</h1>
<p class="sa-sub">Nhập mật khẩu hiện tại và mật khẩu mới</p>

@if (ViewBag.Done == true)
{
    <div class="sa-ok">Đã đổi mật khẩu thành công.</div>
}

<form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="ModelOnly" class="sa-error"></div>

    <div class="sa-field">
        <label asp-for="CurrentPassword"></label>
        <div class="sa-pw">
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <button type="button" class="sa-eye" data-toggle-pw aria-label="Hiện hoặc ẩn mật khẩu"></button>
        </div>
        <span asp-validation-for="CurrentPassword" class="sa-ferr"></span>
    </div>

    <div class="sa-field">
        <label asp-for="NewPassword"></label>
        <div class="sa-pw">
            <input asp-for="NewPassword" autocomplete="new-password" />
            <button type="button" class="sa-eye" data-toggle-pw aria-label="Hiện hoặc ẩn mật khẩu"></button>
        </div>
        <span asp-validation-for="NewPassword" class="sa-ferr"></span>
    </div>

    <div class="sa-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="sa-pw">
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <button type="button" class="sa-eye" data-toggle-pw aria-label="Hiện hoặc ẩn mật khẩu"></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="sa-ferr"></span>
    </div>
    <small class="sa-note">Mật khẩu cần ít nhất 8 ký tự, gồm chữ thường và chữ số.</small>

    <button type="submit" class="st-btn primary sa-block">Đổi mật khẩu</button>
</form>

<p class="sa-foot"><a href="/Profile">← Quay lại hồ sơ</a></p>