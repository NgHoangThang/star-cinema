@model CinemaApp.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_AuthLayout";
    ViewData["SideTitle"] = "Quên mật khẩu là chuyện thường";
    ViewData["SideText"] = "Nhập email, chúng tôi gửi mã 6 số để bạn đặt lại ngay.";
}

<div class="sa-steps">
    <span class="on"><i>1</i> Email</span>
    <span><i>2</i> Nhập mã</span>
    <span><i>3</i> Mật khẩu mới</span>
</div>

<h1>Quên mật khẩu</h1>
<p class="sa-sub">Nhập email đã dùng để đăng ký tài khoản</p>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="sa-error"></div>

    <div class="sa-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" autocomplete="email" placeholder="ten@email.com" />
        <span asp-validation-for="Email" class="sa-ferr"></span>
    </div>

    <button type="submit" class="st-btn primary sa-block">Gửi mã xác minh</button>
</form>

<p class="sa-foot"><a href="/Account/Login">← Quay lại đăng nhập</a></p>