@model CinemaApp.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt mật khẩu mới";
    Layout = "_AuthLayout";
    ViewData["SideTitle"] = "Mật khẩu mới";
    ViewData["SideText"] = "Chọn một mật khẩu mạnh mà bạn dễ nhớ.";
}

<div class="sa-steps">
    <span class="done"><i>✓</i> Email</span>
    <span class="done"><i>✓</i> Nhập mã</span>
    <span class="on"><i>3</i> Mật khẩu mới</span>
</div>

<h1>Đặt mật khẩu mới</h1>
<p class="sa-sub">Tài khoản: <b>@Model.Email</b></p>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="sa-error"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="sa-field">
        <label asp-for="Password"></label>
        <div class="sa-pw">
            <input asp-for="Password" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" />
            <button type="button" class="sa-eye" data-toggle-pw aria-label="Hiện hoặc ẩn mật khẩu"></button>
        </div>
        <span asp-validation-for="Password" class="sa-ferr"></span>
    </div>

    <div class="sa-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="sa-pw">
            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
            <button type="button" class="sa-eye" data-toggle-pw aria-label="Hiện hoặc ẩn mật khẩu"></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="sa-ferr"></span>
    </div>
    <small class="sa-note">Mật khẩu cần ít nhất 8 ký tự, gồm chữ thường và chữ số.</small>

    <button type="submit" class="st-btn primary sa-block">Đặt mật khẩu mới</button>
</form>