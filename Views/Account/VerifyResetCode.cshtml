@model CinemaApp.Models.VerifyResetCodeViewModel
@{
    ViewData["Title"] = "Nhập mã xác minh";
    Layout = "_AuthLayout";
    ViewData["SideTitle"] = "Nhập mã xác minh";
    ViewData["SideText"] = "Mã 6 số đã được gửi tới email của bạn.";
    var devCode = TempData.Peek("DevCode") as string;
}

<div class="sa-steps">
    <span class="done"><i>✓</i> Email</span>
    <span class="on"><i>2</i> Nhập mã</span>
    <span><i>3</i> Mật khẩu mới</span>
</div>

<h1>Nhập mã xác minh</h1>
<p class="sa-sub">Mã đã gửi tới <b>@Model.Email</b>. Không thấy thư? Hãy kiểm tra cả thư rác.</p>

@if (!string.IsNullOrEmpty(devCode))
{
    <div class="sa-dev">
        <b>Chế độ thử nghiệm</b>: web chưa gửi được email thật nên mã hiện ở đây (chỉ có trên máy phát triển).
        <div class="sa-dev-code">@devCode</div>
    </div>
}

<form asp-action="VerifyResetCode" method="post">
    <div asp-validation-summary="ModelOnly" class="sa-error"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Code" />

    <div class="sa-digits" data-otp="#Code">
        @for (int i = 0; i < 6; i++)
        {
            <input class="sa-digit" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Chữ số @(i + 1)" />
        }
    </div>
    <span asp-validation-for="Code" class="sa-ferr"></span>

    <button type="submit" class="st-btn primary sa-block sa-gap">Tiếp tục</button>
</form>

<form asp-action="ForgotPassword" method="post" class="sa-resend">
    <input type="hidden" name="Email" value="@Model.Email" />
    Chưa nhận được mã?
    <button type="submit" class="sa-linkbtn" data-countdown="60" data-label="Gửi lại mã">Gửi lại mã</button>
</form>

<p class="sa-foot"><a href="/Account/ForgotPassword">← Đổi email khác</a></p>