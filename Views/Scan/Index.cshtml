@using CinemaApp.Models
@{
    ViewData["Title"] = "Quét vé";
    ViewData["Dark"] = true;
    var cinemas = (List<Cinema>)ViewBag.Cinemas;
    int? working = ViewBag.Working as int?;
    bool isStaff = ViewBag.IsStaff == true;
    string? workingName = ViewBag.WorkingName as string;
}

<style>
    .sc-head{margin:0 0 20px}
    .sc-head .eb{color:var(--a-gold);font-size:12px;letter-spacing:3px}
    .sc-head h1{font-size:28px;font-weight:800;margin:4px 0 4px;color:var(--a-text)}
    .sc-head p{margin:0;color:var(--a-mute);font-size:14px}
    .sc-box{max-width:960px;background:var(--a-bg2);border:1px solid var(--a-gold);border-radius:12px;padding:26px;box-shadow:0 20px 60px rgba(230,162,60,.12)}
    .sc-box label{display:block;font-size:12px;letter-spacing:1px;color:var(--a-mute);margin-bottom:8px}
    .sc-box input{width:100%;background:#14100c;color:var(--a-gold);border:1px solid #6b5a3a;border-radius:10px;padding:18px 16px;font-size:24px;letter-spacing:3px;font-weight:700;outline:0;text-transform:uppercase;margin-bottom:14px}
    .sc-box input::placeholder{color:#6f6552;font-size:14px;letter-spacing:0;font-weight:400;text-transform:none}
    .sc-box input:focus{border-color:var(--a-gold);box-shadow:0 0 0 3px rgba(230,162,60,.18)}
    .sc-pick{max-width:960px;margin:0 0 16px;padding:18px 20px;border:1px solid var(--a-line);border-radius:12px;background:var(--a-bg2)}
    .sc-pick.warn{border-color:#a67a22;background:rgba(230,162,60,.08)}
    .sc-pick label{display:block;font-size:12px;letter-spacing:1px;color:var(--a-mute);margin-bottom:8px}
    .sc-pick select{width:100%;background:#14100c;color:var(--a-text);border:1px solid #6b5a3a;border-radius:10px;padding:12px 14px;font-size:15px;margin-bottom:12px}
    .sc-pick .hint{margin:0 0 12px;font-size:13px;color:var(--a-mute)}
    .sc-tips{max-width:960px;margin-top:16px;display:grid;gap:10px}
    .sc-tip{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border:1px solid var(--a-line);border-radius:10px;background:var(--a-bg2);color:var(--a-mute);font-size:13px;line-height:1.5}
    .sc-tip b{color:var(--a-gold);font-size:16px;line-height:1.3}
    @@media(max-width:700px){.sc-box{padding:18px}.sc-box input{font-size:20px}}
</style>

<div class="sc-head">
    <div class="eb">QUẢN TRỊ</div>
    <h1>Quét vé</h1>
    <p>Kiểm tra vé và cho khách vào rạp.</p>
</div>

@if (isStaff)
{
    <div class="sc-pick @(working == null ? "warn" : "")">
        <label>RẠP CỦA BẠN</label>
        @if (working == null)
        {
            <p class="hint" style="margin:0">Tài khoản của bạn chưa được gán rạp. Hãy liên hệ quản trị viên.</p>
        }
        else
        {
            <p style="margin:0;font-size:17px;font-weight:700;color:var(--a-gold)">@workingName</p>
            <p class="hint" style="margin:6px 0 0">Bạn chỉ cho vào được vé của rạp này. Muốn đổi rạp, hãy nhờ quản trị viên.</p>
        }
    </div>
}
else
{
<form method="post" action="/Admin/Scan/Cinema" class="sc-pick @(working == null ? "warn" : "")">@Html.AntiForgeryToken()
    <label for="scan-cinema">RẠP ĐANG LÀM VIỆC</label>
    @if (working == null) { <p class="hint">Chọn rạp trước khi quét. Máy quét chỉ cho vào vé của đúng rạp này.</p> }
    <select id="scan-cinema" name="cinemaId">
        @foreach (var c in cinemas)
        {
            <option value="@c.Id" selected="@(working == c.Id)">@c.Name (@c.City.Name)</option>
        }
    </select>
    <button type="submit" class="a-btn" style="padding:10px 20px">@(working == null ? "Chọn rạp này" : "Đổi rạp")</button>
</form>
}

<form method="post" action="/Admin/Scan" class="sc-box">@Html.AntiForgeryToken()
    <label for="scan-code">MÃ ĐẶT VÉ</label>
    <input id="scan-code" type="search" name="code" placeholder="Mã đặt vé, ví dụ SCABCD2345" autocomplete="off" autofocus />
    <button type="submit" class="a-btn" style="width:100%;padding:15px;font-size:16px">Kiểm tra vé</button>
</form>

<div class="sc-tips">
    <div class="sc-tip"><b>1</b><span>Quét mã QR trên vé bằng camera điện thoại (đã đăng nhập tài khoản quản trị hoặc nhân viên), trang kiểm tra sẽ tự mở.</span></div>
    <div class="sc-tip"><b>2</b><span>Hoặc gõ mã đặt vé (dạng SC...) vào ô phía trên rồi bấm Kiểm tra vé.</span></div>
    <div class="sc-tip"><b>3</b><span>Vé hợp lệ thì bấm Cho vào. Mỗi vé chỉ vào được một lần, và chỉ đúng rạp của bạn (ghi ở khung trên).</span></div>
</div>